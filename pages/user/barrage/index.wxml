<view class="container">
  <view class="header">
    <text class="title">发送弹幕</text>
    <text class="subtitle">与大家分享你的想法和心情</text>
  </view>

  <!-- 登录用户信息卡片 -->
  <view class="user-card">
    <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" src="{{formData.avatarUrl || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="avatar-badge">换</view>
    </button>
    <view class="user-info">
      <input class="nickname-input" type="nickname" value="{{formData.nickname}}" placeholder="请输入昵称" bindinput="onInputNickname" />
      <text class="user-tip">点击头像可更换</text>
    </view>
  </view>

  <!-- 弹幕输入区 -->
  <view class="form-group" style="margin-top: 20rpx;">
    <view class="label">你想发送的弹幕</view>
    <textarea
      class="textarea"
      placeholder="说点什么吧..."
      value="{{formData.content}}"
      bindinput="onInputContent"
      maxlength="200"
    ></textarea>
  </view>

  <view class="footer">
    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}">发送</button>
  </view>
</view>
