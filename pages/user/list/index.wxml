<view class="container">
  <block wx:for="{{userList}}" wx:key="userId">
    <view class="user-item" bindtap="onUserTap" data-id="{{item.userId}}" data-isfollowed="{{item.isFollowed}}">
      <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
      
      <view class="info">
        <view class="name-row">
          <text class="nickname">{{item.nickname}}</text>
          <view class="tags">
            <text class="tag tag-nomad">{{item.memberLevel}}</text>
          </view>
        </view>
        <text class="bio">{{item.bio}}</text>
      </view>
      
      <view class="action-btn" wx:if="{{item.userId !== currentUserId}}">
        <follow-button 
          userId="{{item.userId}}" 
          isFollowed="{{item.isFollowed}}" 
          data-index="{{index}}"
          bind:change="onFollowStateChange"
        />
      </view>
    </view>
  </block>
  
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
  
  <view wx:if="{{!loading && userList.length === 0}}" class="empty">
    <text>暂无数据</text>
  </view>
</view>
