<view class="profile-container">
  <!-- 顶部背景图 -->
  <view class="header-bg">
    <image class="bg-image" src="{{userInfo.bgImage || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?ixlib=rb-1.2.1&auto=format&fit=crop&w=1353&q=80'}}" mode="aspectFill" />
    <view class="nav-bar" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="back-btn" bindtap="onBackTap">
        <image class="back-icon" src="/assets/icons/arrow-left-white.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 用户信息区域 -->
  <view class="user-info-card">
    <view class="avatar-row">
      <view class="avatar-wrap">
        <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
        <image class="gender-icon" src="{{userInfo.gender === 1 ? '/assets/icons/male.svg' : '/assets/icons/female.svg'}}" mode="aspectFit" />
      </view>
      <view class="action-btn">
        <button class="follow-btn {{userInfo.isFollowed ? 'followed' : ''}}" bindtap="onFollowTap">
          {{userInfo.isFollowed ? '已关注' : '关注'}}
        </button>
      </view>
    </view>
    
    <view class="info-content">
      <view class="name-row">
        <text class="nickname">{{userInfo.nickname}}</text>
        <view class="tags">
          <text class="tag" wx:for="{{userInfo.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="id-row">
        <text class="user-id">ID {{userInfo.userId}}</text>
      </view>
      <view class="join-row">
        <text class="join-time">{{userInfo.joinTime}}加入</text>
      </view>
      <view class="bio-row">
        <text class="bio">{{userInfo.bio || '这个人很懒，什么都没写~'}}</text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat-item" bindtap="onFollowingTap">
        <text class="stat-num">{{userInfo.followingCount}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-item" bindtap="onFollowersTap">
        <text class="stat-num">{{userInfo.followerCount}}</text>
        <text class="stat-label">粉丝</text>
      </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="tabs-container">
    <view class="tabs">
      <view 
        class="tab-item {{currentTab === 0 ? 'active' : ''}}" 
        data-index="{{0}}" 
        bindtap="onTabChange"
      >
        参与的活动
        <view class="tab-line" wx:if="{{currentTab === 0}}"></view>
      </view>
      <view 
        class="tab-item {{currentTab === 1 ? 'active' : ''}}" 
        data-index="{{1}}" 
        bindtap="onTabChange"
      >
        发布的活动
        <view class="tab-line" wx:if="{{currentTab === 1}}"></view>
      </view>
      <view 
        class="tab-item {{currentTab === 2 ? 'active' : ''}}" 
        data-index="{{2}}" 
        bindtap="onTabChange"
      >
        收藏的活动
        <view class="tab-line" wx:if="{{currentTab === 2}}"></view>
      </view>
    </view>
  </view>

  <!-- 活动列表 -->
  <view class="activity-list">
    <block wx:if="{{currentList.length > 0}}">
      <view class="activity-item" wx:for="{{currentList}}" wx:key="id" bindtap="onActivityTap" data-id="{{item.id}}">
        <image class="activity-poster" src="{{item.poster}}" mode="aspectFill" />
        <view class="activity-info">
          <view class="activity-tags">
             <text class="activity-type-tag">{{item.type}}</text>
          </view>
          <text class="activity-title">{{item.title}}</text>
          <view class="organizer-mini">
            <image class="mini-avatar" src="{{item.organizer.avatar}}" mode="aspectFill" />
            <text class="mini-name">{{item.organizer.name}}</text>
            <text class="mini-tag" wx:if="{{item.organizer.tag}}">{{item.organizer.tag}}</text>
          </view>
          <view class="activity-meta">
            <text class="meta-time">{{item.time}}</text>
          </view>
          <view class="activity-location">
             <text class="meta-location">{{item.location}}</text>
          </view>
          <view class="activity-status">
             <text class="meta-status">{{item.statusText}}</text>
          </view>
          <view class="activity-bottom">
             <view class="joined-avatars">
               <image wx:for="{{item.joinedUsers}}" wx:for-item="u" wx:key="*this" class="joined-avatar" src="{{u}}" mode="aspectFill" />
             </view>
             <text class="joined-count" wx:if="{{item.joinedCount}}">{{item.joinedCount}}人已报名</text>
             <view class="price">
               <text>¥{{item.price}}</text>
               <text style="font-size: 20rpx; font-weight: normal;">/人</text>
             </view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="empty-state">
        <text>暂无活动数据</text>
      </view>
    </block>
  </view>
</view>
