<view class="profile-container">
  <!-- 顶部背景图 -->
  <!-- 顶部背景图 -->
  <view class="header-bg">
    <image class="bg-image" src="https://dao-longtan.oss-cn-heyuan.aliyuncs.com/tool/20260203/longtan_1770118540923_1_1770118540965.png" mode="aspectFill" />
    <view class="blur-area">
      <image class="bg-image blurred" src="https://dao-longtan.oss-cn-heyuan.aliyuncs.com/tool/20260203/longtan_1770118540923_1_1770118540965.png" mode="aspectFill" />
    </view>
    <view class="nav-bar" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="back-btn" bindtap="onBackTap">
        <image class="back-icon" src="/assets/icons/arrow-left-white.png" mode="aspectFit" />
      </view>
    </view>
  </view>
 <view class="content-wrapper">
  <!-- 用户信息区域 -->
  <view class="user-info-card">
    <view class="avatar-row">
      <view class="avatar-wrap">
        <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
        <image wx:if="{{userInfo.gender === 1 || userInfo.gender === 2}}" class="gender-icon" src="{{userInfo.gender === 1 ? '/assets/icons/male.svg' : '/assets/icons/female.svg'}}" mode="aspectFit" />
      </view>
      <view class="info-content">
        <view class="name-row">
          <view class="name-left">
            <text class="nickname">{{userInfo.nickname}}</text>
            
          </view>
          <view class="name-right">
            <text class="tag level-tag tag-nomad-green" wx:for="{{userInfo.levelTags}}" wx:for-item="item" wx:key="label"
                    bindtap="onTagTap" data-action="{{item.action}}">{{item.label}}</text>
          </view>
        </view>

        <view class="id-row">
          <text class="user-id">ID {{userInfo.userNumber}}</text>
        </view>
        <view class="join-row">
          <text class="join-time">{{userInfo.joinTime}}加入</text>
        </view>
      </view>
    </view>
    
    <view class="identity-tags-row" wx:if="{{userInfo.roleTags}}" >
    
         <text class="tag {{item.className}}" wx:for="{{userInfo.roleTags}}" wx:for-item="item" wx:key="label" 
          >{{item.label}}</text>
      </view>
    <view class="bio-row">
      <text class="bio">{{userInfo.bio || '这个人很懒，什么都没写~'}}</text>
    </view>

    <view class="stats-row">
      <view class="stat-item" bindtap="onFollowingTap">
        <text class="stat-num">{{userInfo.followingCount}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-item" bindtap="onFollowersTap">
        <text class="stat-num">{{userInfo.followerCount}}</text>
        <text class="stat-label">粉丝</text>
      </view>
      <view class="stat-item">
      <follow-button 
        userId="{{userInfo.userId}}" 
        isFollowed="{{userInfo.isFollowed}}" 
        bind:change="onFollowStateChange"
      />
       </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="tabs-container">
    <view class="tabs">
      <view 
        class="tab-item {{currentTab === 0 ? 'active' : ''}}" 
        data-index="{{0}}" 
        bindtap="onTabChange"
      >
        参与的活动
        <view class="tab-line" wx:if="{{currentTab === 0}}"></view>
      </view>
      <view 
        class="tab-item {{currentTab === 1 ? 'active' : ''}}" 
        data-index="{{1}}" 
        bindtap="onTabChange"
      >
        发布的活动
        <view class="tab-line" wx:if="{{currentTab === 1}}"></view>
      </view>
      <view 
        class="tab-item {{currentTab === 2 ? 'active' : ''}}" 
        data-index="{{2}}" 
        bindtap="onTabChange"
      >
        收藏的活动
        <view class="tab-line" wx:if="{{currentTab === 2}}"></view>
      </view>
    </view>
  </view>

  <!-- 活动列表 -->
  <view class="activity-list">
    <block wx:if="{{loading}}">
      <view class="loading-state">
        <text>加载中...</text>
      </view>
    </block>
    <block wx:else>
      <block wx:if="{{currentList.length > 0}}">
        <block wx:for="{{currentList}}" wx:key="id">
          <activity-horizontal-card activity="{{item}}" bind:cardtap="onActivityTap" />
        </block>
      </block>
      <block wx:else>
        <view class="empty-state">
          <text>暂无活动数据</text>
        </view>
      </block>
    </block>
  </view>
</view>
</view>

