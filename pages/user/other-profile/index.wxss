.profile-container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 40rpx;
}

.header-bg {
  width: 100%;
  height: 400rpx;
  position: relative;
}

.bg-image {
  width: 100%;
  height: 100%;
}

.nav-bar {
  position: absolute;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  z-index: 10;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

/* User Info Card */
.user-info-card {
  position: relative;
  margin: -60rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 5;
}

.avatar-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: -60rpx;
  margin-bottom: 20rpx;
}

.avatar-wrap {
  position: relative;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  background: #f0f0f0;
}

.gender-icon {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.follow-btn {
  font-size: 26rpx;
  color: #333;
  background: #fff;
  border: 1px solid #333;
  border-radius: 8rpx;
  padding: 10rpx 40rpx;
  line-height: 1.5;
  margin: 0;
}

.follow-btn.followed {
  background: #f0f0f0;
  border-color: #ddd;
  color: #999;
}

.info-content {
  margin-bottom: 30rpx;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  font-size: 20rpx;
  color: #666;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.tag.highlight {
  background: #333;
  color: #fff;
}

.id-row {
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #999;
}

.join-row {
  margin-bottom: 16rpx;
}

.join-time {
  font-size: 24rpx;
  color: #999;
}

.bio-row {
  margin-bottom: 10rpx;
}

.bio {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.stats-row {
  display: flex;
  gap: 60rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* Tabs */
.tabs-container {
  margin-top: 24rpx;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eee;
}

.tabs {
  display: flex;
  justify-content: space-around;
}

.tab-item {
  position: relative;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
}

.tab-item.active {
  color: #333;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #333;
  border-radius: 3rpx;
}

/* Activity List */
.activity-list {
  padding: 24rpx;
}

.activity-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
}

.activity-poster {
  width: 200rpx;
  height: 260rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.activity-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-tags {
  margin-bottom: 8rpx;
}

.activity-type-tag {
  background: #000;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.activity-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.organizer-mini {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.mini-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.mini-name {
  font-size: 24rpx;
  color: #666;
  margin-right: 12rpx;
}

.mini-tag {
  font-size: 20rpx;
  color: #5bb531;
  background: rgba(91, 181, 49, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.activity-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.joined-avatars {
  display: flex;
  margin-right: 12rpx;
}

.joined-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  margin-left: -10rpx;
  border: 2rpx solid #fff;
}

.joined-avatar:first-child {
  margin-left: 0;
}

.joined-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.price {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  background: #5bb531;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.meta-location, .meta-status {
  font-size: 22rpx;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
