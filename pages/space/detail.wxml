<view class="space-detail-page">
  <!-- 顶部图片区域 -->
  <view class="header-image-container" wx:if="{{images.length > 0}}">
    <swiper class="header-swiper" indicator-dots="{{images.length > 1}}" autoplay="{{true}}" circular="{{true}}">
      <block wx:for="{{images}}" wx:key="*this">
        <swiper-item>
          <image class="header-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </block>
    </swiper>
  
  </view>

  <!-- 空间核心信息卡片 -->
  <view class="info-card">
    <!-- 标题与活动数量 -->
    <view class="space-title-row">
        <text class="space-name" wx:if="{{name}}">{{name}}</text>
        
    </view>

    <view class="space-info-container">
        <view class="info-left">
            <view class="meta-row">
                <image class="meta-icon" src="/assets/icons/activity-fire.png" mode="aspectFit" />
                <text class="meta-text">{{activities.length}}个在售活动</text>
            </view>
            
            <view class="meta-row" bindtap="onMapTap" wx:if="{{address}}">
                <image class="meta-icon" src="/assets/icons/location.svg" mode="aspectFit" />
                <text class="meta-text address-text">{{address}}</text>
            </view>
        </view>
        <view class="info-right" bindtap="onPreviewMap" wx:if="{{mapImage}}">
            <image class="map-img" src="{{mapImage}}" mode="aspectFill" />
            <view class="map-hint">点击查看</view>
        </view>
    </view>
    
    
    
    <!-- 空间介绍 (支持富文本与展开收起) -->
    <view class="space-description {{isExpanded ? 'expanded' : ''}}" wx:if="{{description}}">
        <rich-text nodes="{{description}}" class="desc-content"></rich-text>
    </view>
    <view class="expand-btn" bindtap="onToggleExpand" wx:if="{{description}}">
        <text>{{isExpanded ? '收起' : '查看更多'}}</text>
        <image class="arrow-down {{isExpanded ? 'rotated' : ''}}" src="/assets/icons/arrow-down-green.png" />
    </view>
    
    <!-- 主理人区域 -->
    <view class="organizer-section" wx:if="{{organizer}}">
        <user-card user="{{organizer}}" />
    </view>
  </view>

  <!-- 活动列表区域 -->
  <view class="activity-section">
    <view class="section-header">
    在售活动({{activities.length}})
    </view>
    
    <view class="activity-list">
        <block wx:for="{{activities}}" wx:key="id">
            <activity-horizontal-card 
                activity="{{item}}" 
                bind:cardtap="onActivityTap" 
                data-id="{{item.id}}" 
            />
        </block>
        
        <view wx:if="{{activities.length === 0}}" class="empty-state">
            <text>暂无近期活动</text>
        </view>
    </view>
  </view>
</view>
