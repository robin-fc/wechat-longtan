<view class="space-detail-page">
  <!-- 顶部图片区域 -->
  <view class="header-image-container" wx:if="{{images.length > 0}}">
    <swiper class="header-swiper" indicator-dots="{{images.length > 1}}" autoplay="{{true}}" circular="{{true}}">
      <block wx:for="{{images}}" wx:key="*this">
        <swiper-item>
          <image class="header-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </block>
    </swiper>
    <view class="image-count">
       <text class="count-text">{{images.length}} 张图片</text>
    </view>
  </view>

  <!-- 空间核心信息卡片 -->
  <view class="info-card" style="{{images.length === 0 ? 'margin-top: 24rpx;' : ''}}">
    <view class="space-header">
        <text class="space-name" wx:if="{{name}}">{{name}}</text>
    </view>
    
    <view class="space-meta">
        <text class="meta-tag">在售活动 {{activityCount}}</text>
    </view>
    
    <view class="space-address-row" bindtap="onMapTap" wx:if="{{address}}">
        <image class="location-icon" src="/assets/icons/location.png" mode="aspectFit" />
        <text class="address-text">{{address}}</text>
        <image class="arrow-icon" src="/assets/icons/arrow-black.png" mode="aspectFit" />
    </view>
    
    <view class="divider" wx:if="{{address}}"></view>
    
    <view class="space-description" wx:if="{{desc}}">
        <rich-text nodes="{{desc}}" class="desc-text"></rich-text>
    </view>
    
    <!-- 主理人区域 -->
    <view class="organizer-section" wx:if="{{organizer}}">
        <view class="organizer-left">
            <image class="organizer-avatar" src="{{organizer.logo}}" mode="aspectFill" />
            <view class="organizer-info">
                <view class="organizer-name-row">
                    <text class="organizer-name">{{organizer.memberName}}</text>
                    <text class="organizer-badge">主理人</text>
                </view>
                <text class="organizer-desc">发布了 {{activityCount}} 个精彩活动</text>
            </view>
        </view>
        <view class="contact-btn">
            <text>联系TA</text>
        </view>
    </view>
  </view>

  <!-- 活动列表区域 -->
  <view class="activity-section">
    <view class="section-header">
        <text class="section-title">近期活动</text>
    </view>
    
    <view class="activity-list">
        <block wx:for="{{activities}}" wx:key="id">
            <view class="activity-item" bindtap="onActivityTap" data-id="{{item.id}}">
                <view class="activity-cover-box">
                    <image class="activity-cover" src="{{item.poster.url}}" mode="aspectFill" />
                    <view class="activity-status-badge">报名中</view>
                </view>
                <view class="activity-content">
                    <text class="activity-title">{{item.title}}</text>
                    <view class="activity-info-row">
                        <image class="info-icon" src="/assets/icons/time.png" mode="aspectFit" />
                        <text class="info-text">{{item.startTime}}</text>
                    </view>
                    <view class="activity-footer">
                        <view class="price-box">
                             <text class="currency">¥</text>
                             <text class="amount">{{item.price.amount}}</text>
                             <text class="unit">/{{item.price.unit}}</text>
                        </view>
                        <view class="join-btn">立即报名</view>
                    </view>
                </view>
            </view>
        </block>
        
        <view wx:if="{{activities.length === 0}}" class="empty-state">
            <text>暂无近期活动</text>
        </view>
    </view>
  </view>
</view>
