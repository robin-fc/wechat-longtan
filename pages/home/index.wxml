<view class="home-page">
  <view class="top-bar" style="padding-top: {{navPaddingTop}}px;">
    <view class="top-bar-left" bindtap="onSearchTap">
      <image class="search-icon" src="/assets/icons/search.svg" mode="aspectFit" />
    </view>
    <image class="top-title-img" src="/assets/images/DAO.png" mode="heightFix" />
    <view class="top-bar-right"></view>
  </view>
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
  <view wx:else class="content">
    <swiper class="hero-swiper" indicator-dots="{{false}}" circular="true" autoplay="{{false}}" interval="5000"
      duration="350" easing-function="easeInOutCubic" current="{{heroCurrent}}" bindchange="onHeroChange">
      <block wx:for="{{pageData.carousel}}" wx:key="id" wx:for-index="idx">
         <swiper-item class="custom-swiper-item">
          <view class="hero-card {{heroCurrent === idx ? 'selected' : ''}}" bindtap="onBannerTap" data-idx="{{idx}}">
            <view class="hero-poster-wrapper">
              <image class="hero-poster" src="{{item.logo}}" mode="widthFix" />
              <view class="hero-type">{{item.bannerType}}</view>
              
            </view>
          </view>
        </swiper-item>
       
      </block>
    </swiper>
    <view class="hero-indicator" wx:if="{{pageData && pageData.carousel && pageData.carousel.length > 1}}">
      <block wx:for="{{pageData.carousel}}" wx:key="id" wx:for-index="idx">
        <view class="hero-indicator-item {{heroCurrent === idx ? 'active' : ''}}" data-idx="{{idx}}"
          bindtap="onHeroIndicatorTap"></view>
      </block>
    </view>
    <view class="application-section">
      <view class="application-buttons">
        <view class="application-button" bindtap="onDigitalNomadApplyTap">
          <image class="application-icon" src="/assets/icons/home/icon_nomad.svg" mode="aspectFit" />
          <view class="application-text-wrapper">
            <text class="application-label">成为</text>
            <text class="application-label">数字游民</text>
          </view>
        </view>
        <!-- <view class="application-button" bindtap="onVolunteerApplyTap">
          <image class="application-icon" src="/assets/icons/home/icon_volunteer.svg" mode="aspectFit" />
          <view class="application-text-wrapper">
            <text class="application-label">成为</text>
            <text class="application-label">志愿者</text>
          </view>
        </view> -->
        <view class="application-button" bindtap="onCoCreatorApplyTap">
          <image class="application-icon" src="/assets/icons/home/icon_cocreator.svg" mode="aspectFit" />
          <view class="application-text-wrapper">
            <text class="application-label">成为</text>
            <text class="application-label">共创人</text>
          </view>
        </view>
      </view>
    </view>
    <view class="section">
      <view class="entry-grid">
        <block wx:for="{{pageData.entries}}" wx:key="value" wx:for-index="idx">
          <view class="entry-item" data-item="{{item}}" bindtap="onEntryTap">
            <entry-card size="large" title="{{item.label}}" icon-url="{{item.logo}}" />
          </view>
        </block>
      </view>
    </view>
    <view class="section-activity">
      <view class="section-header">
        <image class="section-title-icon" src="/assets/images/hotActivity.png" mode="heightFix" />
        <view class="section-more" bindtap="onMoreHotActivityTap">
          <text>更多</text>
          <image class="more-icon" src="/api/more.svg" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="section-divider-line" />
    <scroll-view scroll-x="true" class="activity-scroll">
      <view class="activity-list">
        <block wx:for="{{pageData.hotActivities}}" wx:key="id">
          <view class="activity-item">
            <activity-card activity="{{item}}" layout="vertical" bindcardtap="onActivityCardTap" />
          </view>
        </block>
      </view>
    </scroll-view>
    <view class="section">
      <view class="section-header">
        <image class="section-title-icon" src="/assets/images/collections.png" mode="heightFix" />
        <view class="section-more" bindtap="onMoreCollectionsTap">
          <text>更多</text>
          <image class="more-icon" src="/api/more.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="section-divider-line" />
      <scroll-view scroll-x="true" class="collection-scroll">
        <view class="collection-row">
          <block wx:for="{{pageData.collections}}" wx:key="id">
            <collection-card collection="{{item}}" bindtap="onCollectionCardTap" />
          </block>
        </view>
      </scroll-view>
    </view>
    <view class="section">
      <view class="section-header">
        <image class="section-title-icon" src="/assets/images/homestay.png" mode="heightFix" />
        <view class="section-more" bindtap="onMoreHomestaysTap">
          <text>更多</text>
          <image class="more-icon" src="/api/more.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="section-divider-line" />
      <view class="homestay-list">
        <block wx:for="{{pageData.homestays}}" wx:key="id">
          <view class="homestay-item">
            <homestay-card homestay="{{item}}" layout="horizontal" show-companions="{{false}}"
              bindtap="onHomestayCardTap" />
          </view>
        </block>
      </view>
    </view>
    <view class="section">
      <view class="section-header">
        <image class="section-title-icon" src="/assets/images/about.png" mode="heightFix" />
      </view>
      <view class="section-divider-line" />
      <view class="about-list">
        <block wx:for="{{pageData.aboutLinks}}" wx:key="id" wx:for-index="idx">
          <view class="about-item" data-item="{{item}}" bindtap="onAboutItemTap">
            <entry-card size="small" title="{{item.title}}" icon-url="{{item.url}}" />
          </view>
        </block>
      </view>
    </view>
  </view>
  <view wx:if="{{canCreateActivity}}" class="floating-publish-btn" bindtap="onFloatingPublishTap">
    <image class="floating-publish-icon" src="/assets/icons/edit-white.svg" mode="aspectFit" />
    <text class="floating-publish-text">发布</text>
  </view>

  <digital-nomad-popup wx:if="{{showDigitalNomadPopup}}" bind:apply="onPopupApply" bind:skip="onPopupSkip" />

  <view class="login-modal" wx:if="{{showPhoneAuthModal}}">
    <view class="modal-mask" bindtap="closePhoneAuthModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">请绑定手机号</text>
        <view class="close-btn" bindtap="closePhoneAuthModal">✕</view>
      </view>
      <view class="modal-body">
        <view class="modal-tip">为了更好地为您服务，请绑定手机号</view>
        <phone-auth checked="{{true}}" className="phone-auth-btn" bindsuccess="onPhoneAuthSuccess"
          binddenied="closePhoneAuthModal">
          立即绑定
        </phone-auth>
      </view>
    </view>
  </view>
</view>