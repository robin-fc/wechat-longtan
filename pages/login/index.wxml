<view class="container">
  <view class="logo">
    <image src="/assets/images/DAO.png" class="logo-img" />
  </view>

  <button wx:if="{{!checked}}" class="login-btn" bindtap="onLoginTap">授权登录</button>
  <button wx:elif="{{checked && !isLoggedIn}}" class="login-btn" bindtap="onWeChatLoginTap">授权登录</button>
  <!-- <phone-auth 
    wx:elif="{{checked && isLoggedIn && !phoneBound}}" 
    checked="{{checked}}"
    className="login-btn"
    bindsuccess="onPhoneAuthSuccess"
    binddenied="onPhoneAuthDenied"
  >
    绑定手机号
  </phone-auth> -->
  <button wx:elif="{{checked && isLoggedIn && !profileCompleted}}" class="login-btn" bindtap="onAuthorizeTap">授权头像昵称</button>

  <view class="cancel-login-btn" bindtap="cancelLoginAndReturn">暂不登录</view>

  <view class="agree-row">
    <checkbox-group bindchange="onCheckChange">
      <checkbox checked="{{checked}}" value="1" />
    </checkbox-group>
    <text>我已阅读并同意</text>
    <text class="link" bindtap="goService">《服务协议》</text>
    <text class="link" bindtap="goPrivacy">《隐私政策》</text>
  </view>

  <view class="login-modal" wx:if="{{showProfileModal}}">
    <view class="modal-mask" bindtap="closeProfileModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">完善个人信息</text>
        <view class="close-btn" bindtap="closeProfileModal">✕</view>
      </view>
      <view class="modal-body">
        <view class="avatar-section">
          <view class="avatar-label">选择头像</view>
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatarProfile">
            <image class="avatar-preview" src="{{previewAvatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
            <text class="avatar-text">点击更换头像</text>
          </button>
        </view>
        <view class="nickname-section">
          <view class="nickname-label">选择或输入昵称</view>
          <input class="nickname-input" type="nickname" placeholder="请输入您的昵称" value="{{previewNickname}}" bindinput="onNicknameInputProfile" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-confirm-btn" bindtap="confirmProfileAndLogin">
          继续登录
        </button>
      </view>
    </view>
  </view>

  <privacy-modal show="{{showModal}}" bindagree="onModalAgree" binddeny="onModalDeny" bindtoservice="goService" bindtoprivacy="goPrivacy" />
</view>
