<view class="room-detail-page">
  <scroll-view scroll-y="true" class="body">
    <image
      wx:if="{{room && room.images && room.images.length}}"
      class="poster-image"
      src="{{room.images[0].url}}"
      mode="aspectFill"
    />
    <image
      wx:else
      class="poster-image"
      src="/assets/images/room.jpg"
      mode="aspectFill"
    />

    <view class="content-wrapper" wx:if="{{room}}">
      <view class="price-row">
        <text class="currency">¥</text>
        <text class="amount">{{room.price.amount}}</text>
      </view>

      <view class="title-row">
        <text class="room-name">{{room.name}}</text>
      </view>

      <view class="tags-row">
        <block wx:for="{{room.tags}}" wx:key="*this">
          <text class="tag-item">{{item}}</text>
        </block>
        <block wx:for="{{room.facilities}}" wx:key="*this" wx:if="{{!room.tags || room.tags.length === 0}}">
           <text class="tag-item">{{item}}</text>
        </block>
      </view>

      <view class="attributes-grid" wx:if="{{room.attributes}}">
        <block wx:for="{{room.attributes}}" wx:key="label">
          <view class="attribute-item">
            <text class="attr-value">{{item.value}}</text>
            <text class="attr-label">{{item.label}}</text>
          </view>
        </block>
      </view>

      <view class="text-section" wx:if="{{room.intro}}">
        <text class="section-title">房间简介</text>
        <text class="section-content">{{room.intro}}</text>
      </view>

      <view class="text-section" wx:if="{{room.notice}}">
        <text class="section-title">预订须知</text>
        <text class="section-content">{{room.notice}}</text>
      </view>

      <view class="text-section" wx:if="{{room.priceRule}}">
        <text class="section-title">价格规则</text>
        <text class="section-content">{{room.priceRule}}</text>
      </view>

      <view class="text-section" wx:if="{{room.checkInProcess}}">
        <text class="section-title">入住流程</text>
        <text class="section-content">{{room.checkInProcess}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-bar" wx:if="{{room}}">
    <view class="submit-button" bindtap="onApplyTap">
      <text>申请预订</text>
    </view>
  </view>
</view>