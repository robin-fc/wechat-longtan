<view class="order-confirm-page">
  <view wx:if="{{activity}}" class="content">
    <view class="header-title-row">
      <text
        class="secondary-tag"
      >{{activity.activityType}}</text>
      <text class="nickname">{{activity.title}}</text>
    </view>

    <view class="info-row time-row">
      <image class="info-icon" src="/assets/icons/time.svg" mode="aspectFit" />
      <text class="info-text">{{activity.startTime}}-{{activity.endTime}}
      </text>
    </view>

    <view class="info-row space-row">
      <view class="space-left" bindtap="onSpaceDetailTap">
        <view class="space-name-wrap">
          <text class="space-name">{{activity.space.name}}</text>
          <text class="arrow-right">›</text>
        </view>
        <text class="space-address">{{activity.space.address}}</text>
      </view>
      <view class="space-right" bindtap="onOpenMapTap">
        <image
          class="mini-map"
          src="{{activity.space.mapImages[0] || '/assets/images/activity.jpg'}}"
          mode="aspectFill"
        />
        <text class="map-hint">点击查看</text>
      </view>
    </view>
  </view>

  <view wx:if="{{activity}}" class="bottom-bar">
    <view class="price-info">
      <text class="price-label">报名费用</text>
      <text class="price-value">
        ￥{{activity.fee}}{{activity.price.unit}}
      </text>
    </view>
    <view class="submit-button" bindtap="onSubmitTap">
      <text>立即报名</text>
    </view>
  </view>

  <view class="form-section">
    <view class="input-item">
      <text class="label">称谓</text>
      <input class="input" placeholder="请填写称谓" value="{{contactName}}" bindinput="onNameChange" />
    </view>
    <view class="input-item">
      <text class="label">联系电话</text>
      <input class="input" placeholder="请输入联系电话" value="{{contactPhone}}" bindinput="onPhoneChange" type="number" maxlength="11" />
    </view>
    
  </view>
</view>

<view class="login-modal" wx:if="{{showPhoneAuthModal}}">
  <view class="modal-mask" bindtap="closePhoneAuthModal"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">请绑定手机号</text>
      <view class="close-btn" bindtap="closePhoneAuthModal">✕</view>
    </view>
    <view class="modal-body">
      <view class="modal-tip">报名活动需要绑定手机号</view>
      <phone-auth 
        checked="{{true}}"
        className="phone-auth-btn"
        bindsuccess="onPhoneAuthSuccess"
        binddenied="closePhoneAuthModal"
      >
        立即绑定
      </phone-auth>
    </view>
  </view>
</view>

