<view class="apply-form-page">
  <scroll-view scroll-y="true" class="body">
    <view wx:if="{{room}}" class="section">
      <text class="title">{{roomNameDisplay}}</text>
      <text class="sub">入住时长：{{room.stayDurationText}}</text>
    </view>
    <view class="section">
      <text class="label">入住日期</text>
      <view class="date-row">
        <picker mode="date" value="{{checkInDate}}" bindchange="onCheckInChange">
          <view class="date-picker">
            <text>{{checkInDate || '选择入住日期'}}</text>
          </view>
        </picker>
        <block wx:if="{{checkInDate && checkOutDate}}">
          <text class="date-sep">共{{nightsCount}}晚</text>
        </block>
        <block wx:else>
          <text class="date-sep">~</text>
        </block>
        <picker mode="date" value="{{checkOutDate}}" bindchange="onCheckOutChange">
          <view class="date-picker">
            <text>{{checkOutDate || '选择离开日期'}}</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="section">
      <text class="label">免费取消截至时间</text>
      <text class="value">{{freeCancelDeadline}}</text>
      <text class="label second">退款政策</text>
      <text class="value">入住前7天可全额退款，之后将根据入住时长和入住规则部分退款。</text>
    </view>
    <view class="section">
      <text class="label">姓名*</text>
      <input class="input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onNameChange" />
      <text class="label second">身份证*</text>
      <input class="input" placeholder="请输入身份证号" value="{{form.idCard}}" bindinput="onIdCardChange" />
      <text class="label second">微信号*</text>
      <input class="input" placeholder="请输入微信号" value="{{form.wechatId}}" bindinput="onWechatChange" />
      <text class="label second">手机号*</text>
      <input class="input" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onPhoneChange" />
    </view>
  </scroll-view>
  <view class="bottom-bar">
    <view class="price-info" wx:if="{{room}}">
      <text class="price-label">合计</text>
      <text class="price-value">￥{{totalPriceDisplay}}/{{room.price.unit}}</text>
    </view>
    <view class="submit-button" bindtap="onSubmitTap">
      <text>提交订单</text>
    </view>
  </view>
</view>
