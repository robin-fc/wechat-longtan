<view class="my-stays-page">
  <view class="filter-row">
    <block wx:for="{{filters}}" wx:key="value">
      <view
        class="filter-item {{item.value === activeFilter ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onFilterTap"
      >
        <text>{{item.label}}</text>
      </view>
    </block>
  </view>

  <scroll-view scroll-y="true" class="list-scroll">
    <block wx:for="{{items}}" wx:key="id">
      <view class="card" data-biz="{{item.id}}" bindtap="onItemTap">
        <view class="row">
          <text class="title">{{item.title}}</text>
          <text class="status">{{item.statusText}}</text>
        </view>
        <view class="row">
          <text class="time">{{item.timeText}}</text>
        </view>
        <view class="row">
          <text class="space">{{item.address}}</text>
        </view>
        <view class="row">
          <view
            wx:if="{{item.showPayButton}}"
            class="pay-btn"
            data-biz="{{item.id}}"
            data-amount="{{item.amount}}"
            bindtap="onPayTap"
          >
            <text>立即支付</text>
          </view>
          <view
            wx:if="{{item.showCancelButton}}"
            class="cancel-btn"
            data-biz="{{item.id}}"
            bindtap="onCancelTap"
          >
            <text>取消订单</text>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>

