<view class="my-stays-page">
  <view class="filter-row">
    <block wx:for="{{filters}}" wx:key="value">
      <view
        class="filter-item {{item.value === activeFilter ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onFilterTap"
      >
        <text>{{item.label}}</text>
      </view>
    </block>
  </view>

  <scroll-view scroll-y="true" class="list-scroll">
    <block wx:for="{{items}}" wx:key="id">
      <view class="card" data-biz="{{item.id}}" bindtap="onItemTap">
        <view class="card-header">
          <text class="date-range">入离日期：{{item.timeText}}</text>
          <view class="status-tag">
            <text>{{item.statusText}}</text>
          </view>
        </view>

        <view class="card-body">
          <image class="room-image" src="{{item.roomImage}}" mode="aspectFill"></image>
          <view class="room-info">
            <view class="room-title">{{item.title}}</view>
            <view class="room-tags">{{item.tags}}</view>
            <view class="room-price">¥ {{item.amount}}</view>
          </view>
        </view>

        <view class="card-footer" wx:if="{{item.showPayButton || item.showCancelButton}}">
          <view
            wx:if="{{item.showPayButton}}"
            class="btn pay-btn"
            data-biz="{{item.id}}"
            data-amount="{{item.amount}}"
            catchtap="onPayTap"
          >
            <text>立即支付</text>
          </view>
          
        </view>
      </view>
    </block>
  </scroll-view>
</view>

