<view class="my-activities-page">
  <view class="filter-bar">
    <scroll-view class="filter-row" scroll-x="true">
      <block wx:for="{{filters}}" wx:key="id">
        <view class="filter-item {{item.id === activeFilterId ? 'active' : ''}}" data-id="{{item.id}}" bindtap="onFilterTap">
          <text>{{item.name}}</text>
        </view>
      </block>
    </scroll-view>
  </view>
  <scroll-view scroll-y="true" class="list-scroll">
    <view wx:if="{{activeFilterId !== 'collections'}}" class="activity-list">
      <block wx:for="{{activities}}" wx:key="id">
        <view class="activity-item">
          <activity-horizontal-card activity="{{item}}" layout="horizontal" bindcardtap="onActivityTap" />
          <view wx:if="{{activeFilterId === 'published' && item.auditStatus}}" class="audit-badge audit-badge--{{item.auditStatus === '审核通过' ? 'pass' : item.auditStatus === '审核拒绝' ? 'fail' : 'pending'}}">
            <text>{{item.auditStatus}}</text>
          </view>
        </view>
      </block>
    </view>
    <view wx:if="{{activeFilterId === 'collections'}}" class="collection-list">
      <block wx:for="{{collections}}" wx:key="id">
        <view class="collection-item">
          <collection-card collection="{{item}}" bindtap="onCollectionTap" />
        </view>
      </block>
    </view>
  </scroll-view>
  <view class="bottom-bar">
    <view class="submit-button" bindtap="onAddCollectionTap">
      <text>添加合集</text>
    </view>
  </view>
</view>
