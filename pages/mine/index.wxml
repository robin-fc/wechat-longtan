<view class="mine-page">
  <!-- 顶部背景图 -->
  <view class="header-bg">
    <image class="bg-image" src="https://dao-longtan.oss-cn-heyuan.aliyuncs.com/tool/20260203/longtan_1770118540923_1_1770118540965.png" mode="aspectFill" />
    <view class="blur-area">
      <image class="bg-image blurred" src="https://dao-longtan.oss-cn-heyuan.aliyuncs.com/tool/20260203/longtan_1770118540923_1_1770118540965.png" mode="aspectFill" />
    </view>
  </view>
  <view class="content-wrapper">
    <!-- 用户信息区域 -->
    <view class="user-info-card">
      <view class="avatar-row">
        <view class="avatar-wrap">
          <image class="avatar" src="{{profile && profile.logo ? profile.logo : '/assets/images/default-avatar.png'}}" mode="aspectFill" />
          <image class="gender-icon" src="{{profile.gender === 1 ? '/assets/icons/male.svg' : '/assets/icons/female.svg'}}" mode="aspectFit" />
        </view>
        <view class="info-content">
          <view class="name-row">
            <view class="name-left">
              <text class="nickname">{{profile ? profile.memberName||profile.wxName : '未登录用户'}}</text>
              <view class="edit-icon-wrap" bindtap="onEditProfileTap">
                <image class="edit-icon" src="/assets/icons/edit.svg" mode="aspectFit" />
              </view>
              <text class="tag level-tag {{item.className}}" wx:for="{{profile.levelTags}}" wx:for-item="item" wx:key="label"
                    bindtap="onTagTap" data-action="{{item.action}}">{{item.label}}</text>
            </view>
            <view class="name-right">
              <text class="tag role-tag {{item.className}}" wx:for="{{profile.noMadTags}}" wx:for-item="item" wx:key="label"
                    bindtap="onTagTap" data-action="{{item.action}}">{{item.label}}</text>
            </view>
          </view>
          <view class="id-row">
            <text class="user-id">ID {{profile.memberNumber || '000000'}}</text>
          </view>
          <view class="join-row">
            <text class="join-time">{{profile.joinTime}}加入</text>
          </view>
        </view>
      </view>
       <view class="identity-tags-row" wx:if="{{profile.roleTags && profile.roleTags.length > 0}}">
         <text class="tag {{item.className}}" wx:for="{{profile.roleTags}}" wx:for-item="item" wx:key="label" 
               bindtap="onTagTap" data-action="{{item.action}}">{{item.label}}</text>
      </view>
      <view class="bio-row">
        <text class="bio">{{profile.desc || '这个人很懒，什么都没写~'}}</text>
      </view>
      <view class="stats-row">
        <view class="stat-item" bindtap="onFollowingTap">
          <text class="stat-num">{{profile.followingCount || 0}}</text>
          <text class="stat-label">关注</text>
        </view>
        <view class="stat-item" bindtap="onFollowersTap">
          <text class="stat-num">{{profile.followerCount || 0}}</text>
          <text class="stat-label">粉丝</text>
        </view>
        <view class="stat-item" bindtap="onWalletTap">
          <text class="stat-num">{{profile.assets || 0}}</text>
          <text class="stat-label">活动收益</text>
        </view>
      </view>
    </view>
    <!-- 菜单列表 -->
    <view class="menu-section">
      <view class="menu-item" bindtap="onMyActivitiesTap">
        <text class="menu-title">我的活动</text>
        <image class="arrow-right" src="/assets/icons/arrow-right.svg" mode="aspectFit" />
      </view>
      <view class="menu-item" bindtap="onMyStaysTap">
        <text class="menu-title">我的入住</text>
        <image class="arrow-right" src="/assets/icons/arrow-right.svg" mode="aspectFit" />
      </view>
      <view class="menu-item" bindtap="onPrivacyTap">
        <text class="menu-title">隐私政策</text>
        <image class="arrow-right" src="/assets/icons/arrow-right.svg" mode="aspectFit" />
      </view>
      <view class="menu-item" bindtap="onServiceTap">
        <text class="menu-title">服务协议</text>
        <image class="arrow-right" src="/assets/icons/arrow-right.svg" mode="aspectFit" />
      </view>
    </view>
    <!-- 退出登录 -->
    <view class="logout-section" wx:if="{{profile}}">
      <view class="logout-btn" bindtap="onLogoutTap">
        <text>退出登录</text>
      </view>
    </view>
  </view>
  <view class="login-modal" wx:if="{{showPhoneAuthModal}}">
    <view class="modal-mask" bindtap="closePhoneAuthModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">请绑定手机号</text>
        <view class="close-btn" bindtap="closePhoneAuthModal">✕</view>
      </view>
      <view class="modal-body">
        <view class="modal-tip">为了更好地为您服务，请绑定手机号</view>
        <phone-auth 
          checked="{{true}}"
          className="phone-auth-btn"
          bindsuccess="onPhoneAuthSuccess"
          binddenied="closePhoneAuthModal"
        >
          立即绑定
        </phone-auth>
      </view>
    </view>
  </view>

  <!-- 待收款弹窗 -->
  <view class="login-modal" wx:if="{{showTransferPopup}}">
    <view class="modal-mask" bindtap="closeTransferPopup"></view>
    <view class="modal-content transfer-popup">
      <view class="modal-header">
        <text class="modal-title">您有 {{transferList.length}} 笔待收款</text>
        <view class="close-btn" bindtap="closeTransferPopup">✕</view>
      </view>
      <view class="modal-body transfer-body">
        <view class="transfer-tip">以下款项已由平台转入您的微信，请点击"收款"完成确认</view>
        <view class="transfer-list">
          <view class="transfer-item" wx:for="{{transferList}}" wx:key="index">
            <view class="transfer-item-info">
              <text class="transfer-item-label">待收款 {{item.index}}</text>
            </view>
            <view class="transfer-collect-btn" bindtap="onTransferItemTap" data-package="{{item.packageInfo}}">
              <text>收款</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>