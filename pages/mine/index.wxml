<!-- 我的 - 自己视角（按设计稿 #1 重构） -->
<view class="mine-page" wx:if="{{profile}}">
  <!-- 顶部头图 -->
  <view class="header-bg">
    <image class="bg-image" src="https://dao-longtan.oss-cn-heyuan.aliyuncs.com/tool/20260203/longtan_1770118540923_1_1770118540965.png" mode="aspectFill" />
  </view>

  <!-- ====== 个人信息卡片 ====== -->
  <view class="profile-card">
    <view class="avatar-row">
      <view class="avatar-wrap">
        <image class="avatar" src="{{profile.logo || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
        <image class="gender-badge" src="{{profile.gender === 1 ? '/assets/icons/male.svg' : '/assets/icons/female.svg'}}" mode="aspectFit" />
      </view>
      <view class="name-area">
        <view class="name-line">
          <text class="nickname">{{profile.memberName || profile.wxName}}</text>
          <view class="edit-btn" bindtap="onEditProfileTap">
            <image class="edit-icon" src="/assets/icons/edit.svg" mode="aspectFit" />
          </view>
          <text class="tag level-tag {{item.className}}" wx:for="{{profile.levelTags}}" wx:for-item="item" wx:key="label">{{item.label}}</text>
        </view>
        <text class="member-id">ID {{profile.memberNumber}}</text>
        <text class="join-date">{{profile.joinTimeText}}加入</text>
      </view>
    </view>

    <view class="identity-tags" wx:if="{{profile.roleTags.length > 0}}">
      <text class="identity-tag {{item.className}}" wx:for="{{profile.roleTags}}" wx:for-item="item" wx:key="label">{{item.label}}</text>
    </view>

    <text class="bio">{{profile.desc || '这个人很懒，什么都没写~'}}</text>

    <view class="homestay-bar" wx:if="{{profile.homestayName}}" bindtap="onHomestayTap">
      <image class="homestay-icon" src="/assets/icons/home/space.svg" mode="aspectFit" />
      <text class="homestay-name">{{profile.homestayName}}</text>
      <image class="homestay-arrow" src="/assets/icons/arrow-right.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- ====== 社区生活 ====== -->
  <view class="section-card">
    <text class="card-title">社区生活</text>
    <view class="card-stats">
      <view class="stat-item" bindtap="onStatTap" data-type="article">
        <text class="stat-value">{{communityLife.articleCount}}</text>
        <text class="stat-desc">文章</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onStatTap" data-type="video">
        <text class="stat-value">{{communityLife.videoCount}}</text>
        <text class="stat-desc">视频</text>
      </view>
    </view>
  </view>

  <!-- ====== 项目 ====== -->
  <view class="section-card">
    <view class="card-header">
      <text class="card-title">项目</text>
      <view class="card-link" catchtap="onProjectTap">
        <text class="link-text">全部</text>
      </view>
    </view>
    <view class="card-stats">
      <view class="stat-item" bindtap="onStatTap" data-type="project-joined">
        <text class="stat-value">{{project.participatedCount}}</text>
        <text class="stat-desc">我参与的</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onStatTap" data-type="project-published">
        <text class="stat-value">{{project.publishedCount}}</text>
        <text class="stat-desc">我发布的</text>
      </view>
    </view>
  </view>

  <!-- ====== 活动 ====== -->
  <view class="section-card">
    <view class="card-header">
      <text class="card-title">活动</text>
      <view class="card-link" catchtap="onMyActivitiesTap">
        <text class="link-text">全部</text>
      </view>
    </view>
    <view class="card-stats">
      <view class="stat-item" bindtap="onStatTap" data-type="activity-joined">
        <text class="stat-value">{{activity.participatedCount}}</text>
        <text class="stat-desc">我参与的</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onStatTap" data-type="activity-published">
        <text class="stat-value">{{activity.publishedCount}}</text>
        <text class="stat-desc">我发布的</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onStatTap" data-type="activity-collected">
        <text class="stat-value">{{activity.collectedCount}}</text>
        <text class="stat-desc">我收藏的</text>
      </view>
    </view>
    <view class="card-stats card-stats-row2">
      <view class="stat-item" bindtap="onStatTap" data-type="activity-pendingReview">
        <text class="stat-value">{{activity.pendingReviewCount}}</text>
        <text class="stat-desc">待评价</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onStatTap" data-type="activity-reviewed">
        <text class="stat-value">{{activity.reviewedCount}}</text>
        <text class="stat-desc">已评价</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onStatTap" data-type="activity-earnings">
        <text class="stat-value">¥{{activity.earnings}}</text>
        <text class="stat-desc">活动收益</text>
      </view>
    </view>
  </view>

  <!-- ====== 入住 ====== -->
  <view class="section-card">
    <view class="card-header">
      <text class="card-title">入住</text>
      <view class="card-link" catchtap="onMyStaysTap">
        <text class="link-text">全部</text>
      </view>
    </view>
    <view class="card-stats">
      <view class="stat-item" bindtap="onStatTap" data-type="stay-pendingPayment">
        <text class="stat-value">{{stay.pendingPaymentCount}}</text>
        <text class="stat-desc">待付款</text>
      </view>
      <!-- <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onStatTap" data-type="stay-pendingAudit">
        <text class="stat-value">{{stay.pendingAuditCount}}</text>
        <text class="stat-desc">待审核</text>
      </view> -->
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onStatTap" data-type="stay-pendingCheckIn">
        <text class="stat-value">{{stay.pendingCheckInCount}}</text>
        <text class="stat-desc">待入住</text>
      </view>
    </view>
  </view>

  <!-- ====== 我的朋友 ====== -->
  <view class="section-card">
    <text class="card-title">我的朋友</text>
    <view class="interest-grid">
      <view class="interest-card" bindtap="onInterestInMeTap">
        <view class="interest-top">
          <text class="interest-label">对我感兴趣的</text>
          <image class="interest-arrow" src="/assets/icons/home/arrow.svg" mode="aspectFit" />
        </view>
        <view class="interest-bottom">
          <text class="interest-count">{{interestedInMe.count}}</text>
          <view class="interest-avatars">
            <image class="interest-avatar" wx:for="{{interestedInMe.users}}" wx:for-item="u" wx:key="userId" src="{{u.logo || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
          </view>
        </view>
      </view>
      <view class="interest-card" bindtap="onMyInterestsTap">
        <view class="interest-top">
          <text class="interest-label">我感兴趣的</text>
          <image class="interest-arrow" src="/assets/icons/home/arrow.svg" mode="aspectFit" />
        </view>
        <view class="interest-bottom">
          <text class="interest-count">{{interested.count}}</text>
          <view class="interest-avatars">
            <image class="interest-avatar" wx:for="{{interested.users}}" wx:for-item="u" wx:key="userId" src="{{u.logo || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ====== 认证入口 ====== -->
  <view class="section-card">
    <view class="cert-grid">
      <view class="cert-item" bindtap="onNomadApplyTap">
        <image class="cert-icon" src="/assets/icons/home/icon_auth.svg" mode="aspectFit" />
        <text class="cert-label">数字游民认证</text>
      </view>
      <view class="cert-item" bindtap="onNewVillagerApplyTap">
        <image class="cert-icon" src="/assets/icons/home/icon_auth.svg" mode="aspectFit" />
        <text class="cert-label">新村民认证</text>
      </view>
      <view class="cert-item" bindtap="onOldVillagerApplyTap">
        <image class="cert-icon" src="/assets/icons/home/icon_auth.svg" mode="aspectFit" />
        <text class="cert-label">老村民认证</text>
      </view>
      <view class="cert-item" bindtap="onCheckInTap">
        <image class="cert-icon" src="/assets/icons/home/icon_checkin.svg" mode="aspectFit" />
        <text class="cert-label">共创签到</text>
      </view>
      <view class="cert-item" bindtap="onDanmuTap">
        <image class="cert-icon" src="/assets/icons/home/icon_chat.svg" mode="aspectFit" />
        <text class="cert-label">大屏发弹幕</text>
      </view>
    </view>
  </view>

  <!-- ====== 底部链接 ====== -->
  <view class="footer-links">
    <text class="footer-text">DAO龙潭的</text>
    <text class="footer-link" bindtap="onPrivacyTap">隐私政策</text>
    <text class="footer-text">与</text>
    <text class="footer-link" bindtap="onServiceTap">服务协议</text>
  </view>

  <view class="logout-section">
    <view class="logout-btn" bindtap="onLogoutTap">
      <text>退出登录</text>
    </view>
  </view>
</view>

<!-- 未登录占位 -->
<view class="mine-page" wx:else>
  <view class="header-bg">
    <image class="bg-image" src="https://dao-longtan.oss-cn-heyuan.aliyuncs.com/tool/20260203/longtan_1770118540923_1_1770118540965.png" mode="aspectFill" />
  </view>
  <view class="empty-state">
    <text class="empty-text">请先登录</text>
  </view>
</view>

<!-- 弹窗（保持兼容） -->
<view class="login-modal" wx:if="{{showPhoneAuthModal}}">
  <view class="modal-mask" bindtap="closePhoneAuthModal"></view>
  <view class="modal-content">
    <view class="modal-header"><text class="modal-title">请绑定手机号</text><view class="close-btn" bindtap="closePhoneAuthModal">✕</view></view>
    <view class="modal-body">
      <view class="modal-tip">为了更好地为您服务，请绑定手机号</view>
      <phone-auth checked="{{true}}" className="phone-auth-btn" bindsuccess="onPhoneAuthSuccess" binddenied="closePhoneAuthModal">立即绑定</phone-auth>
    </view>
  </view>
</view>

<view class="login-modal" wx:if="{{showTransferPopup}}">
  <view class="modal-mask" bindtap="closeTransferPopup"></view>
  <view class="modal-content transfer-popup">
    <view class="modal-header"><text class="modal-title">您有 {{transferList.length}} 笔待收款</text><view class="close-btn" bindtap="closeTransferPopup">✕</view></view>
    <view class="modal-body transfer-body">
      <view class="transfer-tip">以下款项已由平台转入您的微信，请点击"收款"完成确认</view>
      <view class="transfer-list">
        <view class="transfer-item" wx:for="{{transferList}}" wx:key="index">
          <view class="transfer-item-info"><text class="transfer-item-label">待收款 {{item.index}}</text></view>
          <view class="transfer-collect-btn" bindtap="onTransferItemTap" data-package="{{item.packageInfo}}"><text>收款</text></view>
        </view>
      </view>
    </view>
  </view>
</view>
