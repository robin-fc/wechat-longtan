<view class="edit-page">
  <view class="header-bg">
     <image class="bg-image" src="" mode="aspectFill" />
  </view>

  <view class="form-card">
    <view class="avatar-section">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{profile.logo || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="camera-icon">
          <image src="/assets/icons/camera.png" mode="aspectFit" />
        </view>
        <text class="change-text">更换头像</text>
      </button>
    </view>

    <view class="form-item">
      <text class="label">您的昵称</text>
      <input class="input" type="nickname" value="{{profile.memberName}}" maxlength="-1" placeholder="{{profile.memberName||profile.wxName}}" bindinput="onNicknameInput" />
    </view>

    <view class="form-item">
      <text class="label">性别</text>
      <view class="gender-options">
        <view class="gender-opt {{profile.sex === 1 ? 'active' : ''}}" data-value="1" bindtap="onGenderChange">男</view>
        <view class="gender-opt {{profile.sex === 2 ? 'active' : ''}}" data-value="2" bindtap="onGenderChange">女</view>
        <view class="gender-opt {{profile.sex === 0 ? 'active' : ''}}" data-value="0" bindtap="onGenderChange">其TA</view>
      </view>
    </view>

    <view class="form-item">
      <text class="label">个性签名</text>
      <textarea class="textarea" value="{{profile.desc}}" placeholder="假如生活欺骗了你..." bindinput="onBioInput" maxlength="200" />
    </view>
  </view>

  <view class="footer">
    <button class="save-btn" bindtap="onSave" loading="{{loading}}">完成</button>
  </view>
</view>
