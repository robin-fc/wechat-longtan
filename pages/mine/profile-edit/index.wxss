.edit-page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 48rpx;
}

.header-bg {
  width: 100%;
  height: 420rpx;
  
  .bg-image {
    width: 100%;
    height: 100%;
  }
}

.form-card {
  margin-top: -120rpx;
  margin-left: 32rpx;
  margin-right: 32rpx;
  padding: 40rpx 32rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 10;
  margin-bottom: 120rpx;
}

.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
  margin-top: -80rpx;

  .avatar-btn {
    background: none;
    padding: 0;
    margin: 0;
    line-height: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: visible;

    &::after {
      border: none;
    }

    .avatar {
      width: 160rpx;
      height: 160rpx;
      border-radius: 50%;
      border: 6rpx solid #ffffff;
      box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
      margin-bottom: 16rpx;
      background-color: #f0f0f0;
    }

    .camera-icon {
      position: absolute;
      top: 110rpx; // Adjust based on avatar size
      margin-left: 60rpx; // Offset from center
      width: 48rpx;
      height: 48rpx;
      background-color: rgba(0,0,0,0.6);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;

      image {
        width: 28rpx;
        height: 28rpx;
      }
    }

    .change-text {
      font-size: 24rpx;
      color: #666666;
      margin-top: 12rpx;
    }
  }
}

.form-item {
  margin-bottom: 40rpx;

  .label {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #333333;
    margin-bottom: 16rpx;
  }

  .input {
    height: 88rpx;
    border: 1rpx solid #e0e0e0;
    border-radius: 8rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
    color: #333333;
  }

  .gender-options {
    display: flex;
    gap: 24rpx;

    .gender-opt {
      flex: 1;
      height: 72rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #f5f5f5;
      color: #666666;
      font-size: 28rpx;
      border-radius: 8rpx;

      &.active {
        background-color: #7bb02e;
        color: #ffffff;
      }
    }
  }

  .textarea {
    width: 100%;
    height: 240rpx;
    border: 1rpx solid #e0e0e0;
    border-radius: 8rpx;
    padding: 24rpx;
    font-size: 28rpx;
    color: #333333;
    box-sizing: border-box;
  }
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
  z-index: 100;

  .save-btn {
    width: 100%;
    height: 88rpx;
    background-color: #000000;
    color: #ffffff;
    font-size: 32rpx;
    border-radius: 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
  }
}
