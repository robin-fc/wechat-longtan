<view class="assets-page">
  <view class="top-bar">
    <view class="top-bar-left" bindtap="onBackTap">
      <text class="back-icon">←</text>
    </view>
    <text class="top-title">我的资产明细</text>
    <view class="top-bar-right"></view>
  </view>

  <view class="filter-row">
    <block wx:for="{{filters}}" wx:key="value">
      <view
        class="filter-item {{item.value === activeFilter ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onFilterTap"
      >
        <text>{{item.label}}</text>
      </view>
    </block>
  </view>

  <scroll-view scroll-y="true" class="list-scroll">
    <block wx:for="{{groups}}" wx:key="month">
      <view class="month-block">
        <text class="month-title">{{item.month}}</text>
        <block wx:for="{{item.items}}" wx:key="id">
          <view class="record-item">
            <view class="record-main">
              <text class="record-title">{{item.title}}</text>
              <text class="record-desc">{{item.description}}</text>
            </view>
            <view class="record-amount">
              <text
                class="amount {{item.type === 'income' ? 'income' : ''}} {{item.type === 'expense' ? 'expense' : ''}}"
              >
                {{item.type === 'income' ? '+' : '-'}}
                {{item.amount.amount}}
              </text>
              <text class="record-time">{{item.createdAt}}</text>
            </view>
          </view>
        </block>
      </view>
    </block>
    <view wx:if="{{groups.length === 0}}" class="empty">
      <text>暂无资产明细</text>
    </view>
  </scroll-view>
</view>

