<view class="activity-detail-page">
  <view wx:if="{{activity}}" class="header-bar" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
    <view class="header-left" bindtap="onBackTap">
      <image class="back-icon" src="/assets/icons/arrow-down.png" mode="aspectFit" />
    </view>
    <text class="header-title">活动详情</text>
    <view class="header-right"></view>
  </view>
  <view wx:if="{{activity}}" class="body" style="padding-top: {{menuTop + menuHeight + 10}}px;">
    <view class="moment-card">
      <view class="moment-image-wrapper">
        <image class="moment-image" src="{{activity.logo}}" mode="aspectFill" />
        <text class="image-tag">{{activity.activityType}}</text>
      </view>
      <view class="moment-content">
        <view class="price-row">
          <text class="price-symbol">¥</text>
          <text class="price-amount">{{activity.fee}}</text>
        </view>
        
        <view class="header-title-row">
          <text class="secondary-tag">{{activity.activityType}}</text>
          <text class="nickname">{{activity.title}}</text>
        </view>

        <view class="info-row time-row">
          <image class="info-icon" src="/assets/icons/time.png" mode="aspectFit" />
          <text class="info-text">{{activity.startTime}}-{{activity.endTime}}</text>
        </view>

        <view class="info-row space-row">
          <view class="space-left" bindtap="onSpaceDetailTap">
            <view class="space-name-wrap">
              <text class="space-name">{{activity.space.name}}</text>
              <text class="arrow-right">›</text>
            </view>
            <text class="space-address">{{activity.space.address}}</text>
          </view>
          <view class="space-right" bindtap="onOpenMapTap">
            <image 
              class="mini-map" 
              src="{{activity.space.mapImages[0] || '/assets/images/activity.jpg'}}" 
              mode="aspectFill" 
            />
            <text class="map-hint">点击查看</text>
          </view>
        </view>

      </view>
    </view>

    <view class="section organizer-section" wx:if="{{activity.organizer}}">
      <view class="organizer-row">
        <image class="organizer-avatar" src="{{activity.organizer.logo}}" mode="aspectFill" bindtap="onOrganizerTap" />
        <view class="organizer-info">
          <view class="organizer-header">
            <view class="organizer-name-wrap" bindtap="onOrganizerTap">
              <text class="organizer-name">{{activity.organizer.memberName || activity.organizer.wxName}}</text>
              <view class="organizer-tags" wx:if="{{activity.organizer.tags && activity.organizer.tags.length}}">
                <text class="organizer-tag" wx:for="{{activity.organizer.tags}}" wx:key="*this">{{item}}</text>
              </view>
            </view>
            <view class="follow-btn {{isFollowingOrganizer ? 'following' : ''}}" bindtap="onToggleFollowOrganizer">
              <text>{{isFollowingOrganizer ? '已关注' : '关注'}}</text>
            </view>
          </view>
          <text class="organizer-space" wx:if="{{activity.organizer.spaceName}}">所属据点：{{activity.organizer.spaceName}}</text>
        </view>
      </view>

      <!-- Registration Progress -->
      <view class="registration-progress">
        <view class="progress-bar-wrap">
          <view 
            class="progress-bar" 
            style="width: {{registrationLimit > 0 ? (registrationCount / registrationLimit * 100) : 0}}%"
          ></view>
        </view>
        <text class="registration-text" wx:if="{{registrationLimit > 0}}" bindtap="onRegistrationTap">已报名 {{registrationCount}}/{{registrationLimit}}</text>
        <text class="registration-text" wx:else bindtap="onRegistrationTap">已报名 {{registrationCount}}</text>
        
        <view class="registration-avatars" bindtap="onCompanionsTap">
          <block wx:for="{{registrationUsers}}" wx:key="userId">
            <image class="reg-avatar" src="{{item.logo || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
          </block>
          <view class="reg-count-badge" wx:if="{{registrationCount > 0}}">
            <text>{{registrationCount}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">活动详情</text>
      <block wx:if="{{activity.detail}}">
        <rich-text class="section-content" nodes="{{activity.detail}}" />
      </block>
      <block wx:else>
        <text class="section-content">暂无活动的详细介绍、流程和注意事项。</text>
      </block>
    </view>
    <view class="section favorite-section">
      <view class="favorite-row">
        <view class="favorite-avatars">
          <block wx:if="{{favoriteUsers && favoriteUsers.length > 0}}">
            <image 
              wx:for="{{favoriteUsers}}" 
              wx:key="userId" 
              class="avatar" 
              src="{{item.logo || '/assets/images/default-avatar.png'}}" 
              mode="aspectFill" 
            />
          </block>
          <block wx:else>
            <image class="avatar" src="/assets/images/default-avatar.png" mode="aspectFill" />
          </block>
        </view>
        <text class="favorite-text">{{favoriteCountText}}</text>
        <text class="favorite-arrow">›</text>
      </view>
    </view>
    <view class="section">
      <text class="section-title">活动评价</text>
      <text class="section-content default-content">活动还未结束，暂时还没有评价。</text>
    </view>
  </view>
  <view wx:if="{{activity}}" class="bottom-bar">
    <view class="bottom-item" bindtap="onToggleCollect">
      <text class="bottom-label">{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="bottom-item share-btn" open-type="share" bindtap="onShareTap">
      <text class="bottom-label">分享</text>
    </button>
    <view class="bottom-primary" bindtap="onSignupTap">
      <text class="bottom-primary-label">立即报名</text>
    </view>
  </view>
</view>
