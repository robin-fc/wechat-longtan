<view class="activity-detail-page">
  <view wx:if="{{activity}}" class="header">
    <image class="header-bg" src="{{activity.poster.url}}" mode="aspectFill" />
    <view class="header-mask"></view>
  </view>
  <view wx:if="{{activity}}" class="header-bar" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
    <view class="header-left" bindtap="onBackTap">
      <image class="back-icon" src="/assets/icons/arrow-down.png" mode="aspectFit" />
    </view>
    <text class="header-title">活动详情</text>
    <view class="header-right"></view>
  </view>
  <view wx:if="{{activity}}" class="body">
    <view class="moment-card">
      <image class="moment-image" src="{{activity.poster.url}}" mode="aspectFill" />
      <view class="moment-header-wrap">
        <view class="moment-header">
          
          <view class="header-main">
            <view class="header-title-row">
              <text class="secondary-tag">{{activity.secondaryTag.name}}</text>
              <text class="nickname">{{activity.title}}</text>
            </view>
            
          </view>
        </view>
        <view class="moment-actions companions-inline" bindtap="onCompanionsTap">
          <text class="price-inline">￥{{activity.price.amount}}/{{activity.price.unit}}</text>
          <view class="companions-right">
            <view class="companions-avatars">
              <image class="avatar" src="/assets/images/default-avatar.png" mode="aspectFill" />
              <image class="avatar" src="/assets/images/default-avatar.png" mode="aspectFill" />
              <image class="avatar" src="/assets/images/default-avatar.png" mode="aspectFill" />
            </view>
            <companions-bar companions="{{activity.companions}}" />
            <text class="companions-label">人同行</text>
          </view>
        </view>
      </view>
    </view>
    <view class="section">
      <view class="section-row">
        <text class="section-label">时间</text>
        <text class="section-text">{{activity.timeRange.startTime}} - {{activity.timeRange.endTime}}</text>
      </view>
    </view>
    <view class="section">
      <view class="section-row space-row" style="align-items: center;">
        <text class="section-label">活动空间</text>
        <view class="space-main">
          <text class="space-name">{{activity.space.name}}</text>
          <text class="space-address" style="margin-top: 8rpx;">{{activity.space.address}}</text>
        </view>
        <view class="space-actions">
          <view class="space-map" bindtap="onOpenMapTap">
            <image
              wx:if="{{activity.space.mapImages && activity.space.mapImages.length}}"
              src="{{activity.space.mapImages[0]}}"
              mode="aspectFill"
              style="width: 120rpx; height: 120rpx; border-radius: 8rpx;"
            />
            <image
              wx:else
              src="/assets/images/activity.jpg"
              mode="aspectFill"
              style="width: 120rpx; height: 120rpx; border-radius: 8rpx;"
            />
          </view>
          <view class="space-detail" bindtap="onSpaceDetailTap">
            <text>点击查看</text>
          </view>
        </view>
      </view>
    </view>
    <view class="section">
      <text class="section-title">活动详情</text>
      <block wx:if="{{activity.detail}}">
        <rich-text class="section-content" nodes="{{activity.detail}}" />
      </block>
      <block wx:else>
        <text class="section-content">暂无活动的详细介绍、流程和注意事项。</text>
      </block>
    </view>
    <view class="section favorite-section">
      <view class="favorite-row">
        <view class="favorite-avatars">
          <image class="avatar" src="/assets/images/default-avatar.png" mode="aspectFill" />
          <image class="avatar" src="/assets/images/default-avatar.png" mode="aspectFill" />
          <image class="avatar" src="/assets/images/default-avatar.png" mode="aspectFill" />
        </view>
        <text class="favorite-text">{{favoriteCountText}}</text>
        <text class="favorite-arrow">›</text>
      </view>
    </view>
    <view class="section">
      <text class="section-title">活动评价</text>
      <text class="section-content default-content">活动还未结束，暂时还没有评价。</text>
    </view>
  </view>
  <view wx:if="{{activity}}" class="bottom-bar">
    <view class="bottom-item" bindtap="onToggleCollect">
      <text class="bottom-label">{{isCollected ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="bottom-item" bindtap="onShareTap">
      <text class="bottom-label">分享</text>
    </view>
    <view class="bottom-primary" bindtap="onSignupTap">
      <text class="bottom-primary-label">立即报名</text>
    </view>
  </view>
</view>
