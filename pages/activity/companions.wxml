<view class="companions-page">
  <view class="top-bar">
    <view class="top-bar-left" bindtap="onBackTap">
      <text class="back-icon">←</text>
    </view>
    <text class="top-title">同行的人</text>
    <view class="top-bar-right"></view>
  </view>

  <view class="list-wrapper">
    <block wx:for="{{companions}}" wx:key="id">
      <view class="companion-item">
        <image
          class="avatar"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
        />
        <view class="info">
          <text class="name">{{item.nickname}}</text>
          <text class="bio">{{item.bio}}</text>
        </view>
        <view
          class="follow-btn {{item.isFollowed ? 'followed' : ''}}"
          data-id="{{item.id}}"
          bindtap="onFollowTap"
        >
          <text>
            {{item.isFollowed ? '已关注' : '关注'}}
          </text>
        </view>
      </view>
    </block>
  </view>
</view>

