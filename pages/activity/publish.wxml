<view class="publish-page">
  <!-- 导航栏（与项目其他页面一致） -->
  <view class="header-bar" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
    <view class="header-left" bindtap="onBackTap">
      <image class="back-icon" src="/assets/icons/arrow-down.png" mode="aspectFit" />
    </view>
    <text class="header-title">{{isEdit ? '编辑活动' : '发布活动'}}</text>
    <view class="header-right"></view>
  </view>

  <scroll-view scroll-y="true" class="form-scroll" style="padding-top: {{menuTop + menuHeight + 10}}px;">

    <view class="form-section">
      <text class="label">活动标题*</text>
      <input class="input" placeholder="请输入活动标题" value="{{form.title}}" bindinput="onTitleChange" />
    </view>

    <view class="form-section">
      <text class="label">关联合集</text>
      <picker mode="selector" range="{{collectionOptions}}" range-key="name" value="{{collectionIndex}}" bindchange="onCollectionChange">
        <view class="picker-value">
          <text>{{form.collectionId ? collectionOptions[collectionIndex].name : '可选，选择一个合集'}}</text>
        </view>
      </picker>
    </view>

    <view class="form-section inline">
      <view class="inline-left">
        <text class="label">报名费*</text>
        <view class="inline-right">
          <input class="input" type="digit" placeholder="请输入金额" value="{{form.price}}" bindinput="onPriceChange" disabled="{{form.free}}" />
          <checkbox-group bindchange="onFreeChange">
            <checkbox value="free" checked="{{form.free}}">免费</checkbox>
          </checkbox-group>
        </view>
      </view>

    </view>

    <view class="form-section">
      <text class="label">活动类型*</text>
      <picker mode="selector" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">
          <text>{{types[typeIndex].label}}</text>
        </view>
      </picker>
    </view>

    <view class="form-section">
      <text class="label">人数限制*</text>
      <input class="input" type="number" maxlength="3" placeholder="请输入人数" value="{{form.limit}}" bindinput="onLimitChange" />
    </view>

    <view class="form-section">
      <text class="label">活动时间*</text>
      <view class="time-row">
        <view class="time-col">
          <text class="time-subtitle">开始</text>
          <datetime-picker value="{{form.startTime}}" bindchange="onStartISOChange" />
        </view>
        <view class="time-col">
          <text class="time-subtitle">结束</text>
          <datetime-picker value="{{form.endTime}}" bindchange="onEndISOChange" />
        </view>
      </view>
    </view>

    <view class="form-section">
      <text class="label">活动空间*</text>
      <picker mode="selector" range="{{spaceOptions}}" range-key="name" value="{{spaceIndex}}" bindchange="onSpaceChange">
        <view class="picker-value">
          <text>{{spaceOptions[spaceIndex].name}}</text>
        </view>
      </picker>
    </view>

    <view class="form-section">
      <text class="label">活动海报</text>
      <view class="poster-row">
        <view wx:if="{{form.logo}}" class="poster-preview">
          <image class="poster-image" src="{{form.logo}}" mode="aspectFill" />
        </view>
        <view class="poster-upload" bindtap="onChoosePosterTap">
          <text>上传图片</text> 
        </view>
        <text wx:if="{{!form.logo}}" class="label">如不上传图片,可使用系统生成的默认海报</text>
      </view>
    </view>

    <view class="form-section">
      <text class="label">活动介绍*</text>
      <textarea class="textarea" maxlength="-1" placeholder="请填写活动介绍、流程和须知" value="{{form.description}}" bindinput="onDescriptionChange" />
    </view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="preview-button {{isEdit ? '' : 'full-width'}}" bindtap="onPreviewTap">
      <text>预览</text>
    </view>
    <view wx:if="{{isEdit}}" class="submit-button" bindtap="onSubmitTap">
      <text>保存修改</text>
    </view>
  </view>

  <permission-popup
    visible="{{showPermissionPopup}}"
    message="完成数字游民认证申请就可以发布活动了哦！"
    bind:apply="onPermissionApply"
    bind:skip="onPermissionSkip" />

  <!-- 退出确认弹窗 -->
  <view wx:if="{{showExitConfirm}}" class="exit-mask" catchtap="onCancelExit">
    <view class="exit-dialog" catchtap="">
      <text class="exit-dialog-title">确认退出？</text>
      <text class="exit-dialog-desc">当前活动未发布，退出将删除当前编辑活动</text>
      <view class="exit-dialog-actions">
        <view class="exit-btn exit-btn-cancel" bindtap="onCancelExit">
          <text>返回编辑</text>
        </view>
        <view class="exit-btn exit-btn-confirm" bindtap="onConfirmExit">
          <text>继续退出</text>
        </view>
      </view>
    </view>
  </view>
</view>

