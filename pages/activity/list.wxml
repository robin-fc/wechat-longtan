<view class="activity-list-page">
  <view class="search-row">
    <view class="search-input-wrapper" bindtap="onSearchTap">
      <image class="search-icon" src="/assets/icons/search.svg" mode="aspectFit" />
      <text class="search-placeholder">搜索活动/活动空间</text>
    </view>
    <view class="publish-button" bindtap="onPublishTap">
      <image class="publish-icon" src="/assets/icons/edit-white.svg" mode="aspectFit" />
      <text>发布</text>
    </view>
  </view>

  <view class="filter-bar">
    <scroll-view class="filter-row" scroll-x="true">
      <block wx:for="{{filterGroups}}" wx:key="id">
        <view
          class="filter-group {{item.id === activeGroupId ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onFilterGroupTap"
        >
          <text>{{item.name}}</text>
        </view>
      </block>
    </scroll-view>
    <scroll-view class="filter-row second" scroll-x="true">
      <block wx:for="{{activeItems}}" wx:key="id">
        <view
          class="filter-item {{item.id === activeItemId ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onFilterItemTap"
        >
          <text>{{item.name}}</text>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="status-tab-bar">
    <block wx:for="{{statusList}}" wx:key="value">
      <view 
        class="status-tab-item {{item.value === currentStatus ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onStatusTabTap"
      >
        <text>{{item.name}}</text>
      </view>
    </block>
  </view>

  <view class="list-wrapper">
    <block wx:for="{{activities}}" wx:key="id">
      <view class="activity-item">
        <activity-horizontal-card
          activity="{{item}}"
          bindcardtap="onActivityTap"
        />
      </view>
    </block>
  </view>
</view>

