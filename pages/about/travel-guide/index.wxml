<view class="travel-guide-page">
  <view class="page-header">
    <view class="header-title">龙潭村在地生活指南</view>
    <view class="header-desc">抵达与居住的实用信息</view>
  </view>

  <view class="guide-content">
    <block wx:for="{{sections}}" wx:key="title" wx:for-item="section">
      <view class="guide-section">
        <view class="section-title">{{section.title}}</view>
        <view class="section-items">
          <block wx:for="{{section.items}}" wx:key="label" wx:for-item="item">
            <view class="guide-item">
              <view class="item-label">{{item.label}}</view>
              <view class="item-content">
                <block wx:for="{{item.content}}" wx:key="index" wx:for-item="segment">
                  <text wx:if="{{segment.type === 'text'}}" user-select>{{segment.text}}</text>
                  <text wx:if="{{segment.type === 'phone'}}" class="phone-link" bindtap="onPhoneTap" data-phone="{{segment.phoneNumber}}">{{segment.text}}</text>
                </block>
              </view>
            </view>
          </block>
        </view>
      </view>
    </block>
  </view>
</view>
