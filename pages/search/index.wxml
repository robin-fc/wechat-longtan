<view class="search-page">
  <view class="search-box">
    <view class="search-input-wrapper">
      <image class="search-icon" src="/assets/icons/search.svg" mode="aspectFit" />
      <input
        class="search-input"
        placeholder="{{placeholder}}"
        confirm-type="search"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearchConfirm"
      />
    </view>
    <view class="search-button" bindtap="onSearchTap">
      <text>搜索</text>
    </view>
  </view>

  <view wx:if="{{!hasSearched || activities.length === 0}}" class="hot-section">
    <text class="hot-title">热门推荐</text>
    <view class="hot-grid">
      <block wx:for="{{hotKeywords}}" wx:key="id">
        <view
          class="hot-item"
          data-keyword="{{item.keyword}}"
          bindtap="onHotKeywordTap"
        >
          <text>{{item.keyword}}</text>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{hasSearched}}" class="result-container">
    <view wx:if="{{activities.length === 0 && collections.length === 0 && homestays.length === 0}}" class="empty-state">
      <text>未找到相关结果</text>
    </view>

    <!-- Activity Collections -->
    <view wx:if="{{collections.length > 0}}" class="section">
      <view class="section-title">活动合集</view>
      <block wx:for="{{collections}}" wx:key="id">
        <view class="item-wrapper">
          <collection-card
            collection="{{item}}"
            bindtap="onCollectionTap"
          />
        </view>
      </block>
    </view>

    <!-- Activities -->
    <view wx:if="{{activities.length > 0}}" class="section">
      <view class="section-title">活动</view>
      <block wx:for="{{activities}}" wx:key="id">
        <view class="item-wrapper">
          <activity-horizontal-card
            activity="{{item}}"
            bindcardtap="onActivityTap"
          />
        </view>
      </block>
    </view>

    <!-- Homestays -->
    <view wx:if="{{homestays.length > 0}}" class="section">
      <view class="section-title">民宿</view>
      <block wx:for="{{homestays}}" wx:key="id">
        <view class="item-wrapper">
          <homestay-card
            homestay="{{item}}"
            bindtap="onHomestayTap"
          />
        </view>
      </block>
    </view>
  </view>
</view>

