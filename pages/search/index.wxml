<view class="search-page">
  <view class="search-box">
    <input
      class="search-input"
      placeholder="{{placeholder}}"
      confirm-type="search"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearchConfirm"
    />
    <view class="search-button" bindtap="onSearchTap">
      <text>搜索</text>
    </view>
  </view>

  <view wx:if="{{!hasSearched || activities.length === 0}}" class="hot-section">
    <text class="hot-title">热门搜索</text>
    <view class="hot-grid">
      <block wx:for="{{hotKeywords}}" wx:key="id">
        <view
          class="hot-item"
          data-keyword="{{item.keyword}}"
          bindtap="onHotKeywordTap"
        >
          <text>{{item.keyword}}</text>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{hasSearched && activities.length > 0}}" class="list-wrapper">
    <block wx:for="{{activities}}" wx:key="id">
      <view class="activity-item">
        <activity-card
          activity="{{item}}"
          layout="horizontal"
          bindtap="onActivityTap"
        />
      </view>
    </block>
  </view>
</view>

