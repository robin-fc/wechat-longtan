<view class="homestay-list-page">
  <view class="filter-row">
    <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
      <view class="date-picker">
        <text>{{startDate || '选择入住时间'}}</text>
      </view>
    </picker>
  </view>

  <view class="list-wrapper">
    <block wx:for="{{homestays}}" wx:key="id">
      <view class="homestay-item">
        <homestay-card homestay="{{item}}" layout="vertical" bindtap="onHomestayTap" />
      </view>
    </block>
  </view>
</view>
