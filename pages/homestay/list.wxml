<view class="homestay-list-page">
  <view class="top-bar">
    <view class="top-bar-left" bindtap="onBackTap">
      <text class="back-icon">←</text>
    </view>
    <text class="top-title">民宿</text>
    <view class="top-bar-right"></view>
  </view>

  <view class="filter-row">
    <picker
      mode="date"
      value="{{startDate}}"
      bindchange="onStartDateChange"
    >
      <view class="date-picker">
        <text>
          {{startDate || '选择入住时间'}}
        </text>
      </view>
    </picker>
    <view class="duration-row">
      <block wx:for="{{durations}}" wx:key="value">
        <view
          class="duration-item {{item.value === duration ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onDurationTap"
        >
          <text>{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="list-wrapper">
    <block wx:for="{{homestays}}" wx:key="id">
      <view class="homestay-item">
        <homestay-card
          homestay="{{item}}"
          layout="horizontal"
          bindtap="onHomestayTap"
        />
      </view>
    </block>
  </view>
</view>

