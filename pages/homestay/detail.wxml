<view class="homestay-detail-page">
  <scroll-view scroll-y="true" class="body">
    <swiper 
      wx:if="{{homestay && homestay.images && homestay.images.length > 0}}"
      class="poster-swiper" 
      indicator-dots="{{true}}" 
      circular="{{true}}" 
      autoplay="{{true}}" 
      interval="5000" 
      duration="500"
      indicator-active-color="#ffffff"
      indicator-color="rgba(255, 255, 255, 0.5)"
    >
      <block wx:for="{{homestay.images}}" wx:key="*this">
        <swiper-item>
          <image class="poster-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </block>
    </swiper>
    <image
      wx:elif="{{homestay}}"
      class="poster-image"
      src="{{homestay.logo}}"
      mode="aspectFill"
    />
    <view wx:if="{{homestay}}" class="intro-card">
      <view class="intro-content">
        <view class="intro-main">
          <text class="name">{{homestay.name}}</text>
          <view class="tags">
            <block wx:for="{{homestay.tags}}" wx:key="*this">
              <text class="tag tag-{{index % 3}}">{{item}}</text>
            </block>
          </view>
          <view class="info-row" wx:if="{{rooms.length}}">
             <image class="info-icon" src="/assets/icons/home.svg" mode="aspectFit" />
             <text class="info-text">{{rooms.length}}个在售房型</text>
          </view>
          <view class="info-row" bindtap="onOpenMap">
             <image class="info-icon" src="/assets/icons/location.svg" mode="aspectFit" />
             <text class="info-text address-text">{{homestay.address}}</text>
          </view>
        </view>
        
        <view class="intro-map" bindtap="onOpenMap" wx:if="{{homestay.mapImages.length}}">
           <image class="map-thumbnail" src="{{homestay.mapImages[0]}}" mode="aspectFill" />
           <text class="map-hint">点击查看</text>
        </view>

      
      </view>

      <view class="description-box" wx:if="{{homestay.description}}">
        <rich-text class="description {{isDescriptionExpanded ? 'expanded' : 'collapsed'}}" nodes="{{homestay.description}}"></rich-text>
        <rich-text class="description description-measure" nodes="{{homestay.description}}"></rich-text>
        <view class="expand-btn" bindtap="toggleDescription" wx:if="{{showExpandBtn}}">
          <text>{{isDescriptionExpanded ? '收起' : '查看更多'}}</text>
          <image class="expand-icon {{isDescriptionExpanded ? 'rotate' : ''}}" src="/assets/icons/arrow-down-green.png" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="section">
      <view class="filter-row">
        <view class="date-selection-row">
          <text class="filter-label">入住时间</text>
          <picker mode="date" value="{{startDate}}" start="{{minDate}}" bindchange="onStartDateChange">
            <view class="date-picker">
              <text class="picker-text">{{startDate || '选择入住时间'}}</text>
              <image class="picker-icon" src="/assets/icons/arrow-down.png" mode="aspectFit" />
            </view>
          </picker>
        </view>
        <view class="duration-selection-row">
           <text class="filter-label">入住时长</text>
           <view class="duration-options">
              <block wx:for="{{durations}}" wx:key="value">
                <view class="duration-item {{item.value === duration ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onDurationTap">
                  <text>{{item.label}}</text>
                </view>
              </block>
           </view>
        </view>
      </view>
    </view>
    <view class="section">
      <view class="room-list" wx:if="{{isRoomsLoading}}">
         <view class="loading-state">
           <text class="loading-text">数据加载中...</text>
         </view>
      </view>
      <view class="room-list" wx:elif="{{rooms && rooms.length > 0}}">
        <block wx:for="{{rooms}}" wx:key="id">
          <view class="room-item">
            <homestay-room-card room="{{item}}" bindtap="onRoomTap" />
          </view>
        </block>
      </view>
      <view class="empty-rooms" wx:else>
         <text class="empty-text">对不起，您所选时间没有合适房源了，请修改日期后再试</text>
      </view>
    </view>
  </scroll-view>
</view>
