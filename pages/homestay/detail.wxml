<view class="homestay-detail-page">
  <view class="header">
    <image
      wx:if="{{homestay}}"
      class="header-bg"
      src="{{homestay.cover.url}}"
      mode="aspectFill"
    />
    <view wx:else class="header-placeholder"></view>
    <view class="header-mask"></view>
  </view>
  <view class="header-bar" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
    <view class="header-left" bindtap="onBackTap">
      <image class="back-icon" src="/assets/icons/arrow-down.png" mode="aspectFit" />
    </view>
    <text class="header-title">民宿详情</text>
    <view class="header-right"></view>
  </view>
  <scroll-view scroll-y="true" class="body">
    <view wx:if="{{homestay}}" class="intro-card">
      <text class="name">{{homestay.name}}</text>
      <view class="tags">
        <block wx:for="{{homestay.featureTags}}" wx:key="id">
          <text class="tag">{{item.name}}</text>
        </block>
      </view>
      <text class="address">{{homestay.address}}</text>
    </view>
    <view class="section">
      <view class="filter-row">
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="date-picker">
            <text>{{startDate || '选择入住时间'}}</text>
          </view>
        </picker>
        <view class="duration-row">
          <block wx:for="{{durations}}" wx:key="value">
            <view class="duration-item {{item.value === duration ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onDurationTap">
              <text>{{item.label}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
    <view class="section">
      <view class="room-list">
        <block wx:for="{{rooms}}" wx:key="id">
          <view class="room-item">
            <homestay-room-card room="{{item}}" bindtap="onRoomTap" />
          </view>
        </block>
      </view>
    </view>
  </scroll-view>
</view>
