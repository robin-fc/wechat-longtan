<view class="homestay-card {{layout}}" bindtap="onTap">
  <image
    class="poster"
    src="{{homestay.cover.url}}"
    mode="aspectFill"
  />
  <view class="content">
    <text class="name">{{homestay.name}}</text>
    <view class="tags">
      <block
        wx:for="{{homestay.featureTags}}"
        wx:key="id"
        wx:for-item="item"
      >
        <text class="tag">{{item.name}}</text>
      </block>
    </view>
    <view class="footer">
      <view class="price">
        <text class="symbol">￥</text>
        <text class="amount">{{homestay.minPrice}}</text>
        <text class="unit"> /天起</text>
      </view>
      <view class="address">
        <text class="address-label">地址：</text>
        <text class="address-text">{{homestay.address}}</text>
      </view>
    </view>
  </view>
</view>

