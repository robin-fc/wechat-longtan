<view class="activity-card {{layout}}" bindtap="onTap">
  <view class="relative">
    <image class="poster" src="{{activity.poster.url}}" mode="aspectFill" />
    <block wx:if="{{layout !== 'horizontal'}}">
      <companions-bar companions="{{activity.companions}}" class="content" />
    </block>
    <text class="tag">{{activity.secondaryTag.name}}</text>
  </view>

  <view class="content">
    <view class="title-row">
      <text class="title">{{activity.title}}</text>
    </view>
    <view class="time-row">
      <text class="time">
        {{layout === 'horizontal'
          ? (activity.timeRange.startTime + ' ~ ' + activity.timeRange.endTime)
          : activity.timeRange.startTime}}
      </text>
      <text class="price">
        ￥{{activity.price.amount}}/{{activity.price.unit}}
      </text>
    </view>
    <block wx:if="{{layout === 'horizontal'}}">
      <companions-bar companions="{{activity.companions}}" class="companions-row" />
    </block>
  </view>
</view>
