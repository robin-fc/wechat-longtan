<view class="dtp-container">
  <view class="dtp-display" bindtap="openPanel">
    <text class="dtp-display-text">{{isoText || placeholder}}</text>
    <text class="dtp-display-icon">🗓️</text>
  </view>

  <view wx:if="{{showPanel}}" class="dtp-overlay" catchtouchmove="noop">
    <view class="dtp-dialog">
      <view class="dtp-header">
        <text class="dtp-title">选择日期时间</text>
      </view>
      <view class="dtp-body">
        <picker mode="date" value="{{tempDate}}" bindchange="onDateChange">
          <view class="dtp-picker">
            <text>{{tempDate || placeholderDate}}</text>
          </view>
        </picker>
        <picker mode="time" value="{{tempTime}}" bindchange="onTimeChange">
          <view class="dtp-picker">
            <text>{{tempTime || placeholderTime}}</text>
          </view>
        </picker>
        <view class="dtp-preview">
          <text>{{previewISO}}</text>
        </view>
      </view>
      <view class="dtp-footer">
        <view class="dtp-btn cancel" bindtap="onCancel">取消</view>
        <view class="dtp-btn confirm" bindtap="onConfirm">确定</view>
      </view>
    </view>
  </view>
</view>
