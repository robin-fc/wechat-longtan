.dtp-container { display: flex; flex-direction: column; gap: 8rpx; }
.dtp-display { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 20rpx; background: #fff; border: 1rpx solid #dcdfe6; border-radius: 8rpx; }
.dtp-display-text { color: #606266; font-size: 28rpx; }
.dtp-display-icon { color: #909399; font-size: 28rpx; }

.dtp-overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 999; }
.dtp-dialog { width: 640rpx; background: #fff; border-radius: 12rpx; overflow: hidden; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2); }
.dtp-header { padding: 24rpx; border-bottom: 1rpx solid #ebeef5; }
.dtp-title { font-size: 30rpx; color: #303133; }
.dtp-body { padding: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.dtp-picker { padding: 16rpx 20rpx; background: #f5f7fa; border: 1rpx solid #e4e7ed; border-radius: 8rpx; }
.dtp-preview { color: #909399; font-size: 24rpx; padding: 8rpx 4rpx; }
.dtp-footer { display: flex; justify-content: flex-end; gap: 16rpx; padding: 16rpx 24rpx; border-top: 1rpx solid #ebeef5; }
.dtp-btn { padding: 12rpx 24rpx; border-radius: 8rpx; font-size: 26rpx; }
.dtp-btn.cancel { background: #f5f7fa; color: #606266; border: 1rpx solid #dcdfe6; }
.dtp-btn.confirm { background: #409EFF; color: #fff; }
